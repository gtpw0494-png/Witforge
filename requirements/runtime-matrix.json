{
  "format": "uai-runtime-matrix-v1",
  "node": {
    "packageEngine": ">=20",
    "authoritativeCI": "24",
    "server": "server.js",
    "notes": "Node runtime availability is distinct from optional model/plugin runtime availability."
  },
  "python": {
    "authoritativeCI": "3.13",
    "core": {
      "required": ["sqlite3", "hashlib", "json", "pathlib"],
      "installation": "Python standard library"
    },
    "neural": {
      "torch": {"requiredFor": ["ForgeLM training", "ForgeLM neural tests"], "ciInstall": "python3 -m pip install --upgrade pip torch", "optionalForCore": true},
      "transformers": {"requiredFor": ["optional Transformers model runtime"], "optional": true},
      "onnxruntime": {"requiredFor": ["optional ONNX inference runtime"], "optional": true},
      "sentence_transformers": {"requiredFor": ["optional neural dense embeddings and cross-encoder reranking"], "optional": true},
      "pypdf": {"requiredFor": ["optional PDF text extraction fallback"], "optional": true},
      "PIL": {"package": "Pillow", "requiredFor": ["optional image metadata/processing"], "optional": true},
      "whisper": {"requiredFor": ["optional local speech transcription"], "optional": true}
    }
  },
  "externalCommands": {
    "git": {"requiredFor": ["worktrees", "repository intelligence"], "core": true},
    "tesseract": {"requiredFor": ["optional OCR"], "optional": true},
    "pdftotext": {"requiredFor": ["optional PDF text extraction"], "optional": true},
    "ffmpeg": {"requiredFor": ["optional audio/video media probing and extraction"], "optional": true},
    "llama-cli": {"aliases": ["llama", "llama-server"], "requiredFor": ["optional llama.cpp runtime"], "optional": true},
    "ollama": {"requiredFor": ["optional Ollama runtime"], "optional": true}
  },
  "policy": "An entry in this matrix documents a dependency boundary only. UAI must probe the live runtime before reporting CONNECTED."
}
