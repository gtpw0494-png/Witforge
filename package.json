{
  "name": "witforge",
  "version": "2.13.0",
  "description": "WitForge — a local-first, security-first conversational AI operating platform (browser control surface + authoritative local server).",
  "keywords": [
    "local-first",
    "permissions",
    "audit",
    "orchestration",
    "arena",
    "forgelm",
    "context-engineering",
    "governed-memory"
  ],
  "license": "UNLICENSED",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node build.js",
    "lint": "node lint.js",
    "test": "node forgelm-test.js && node spec-test.js && node storage-test.js && node adversarial-test.js && node platform-test.js && node arena-test.js && node engagement-test.js && node smoke-test.js",
    "test:spec": "node spec-test.js",
    "test:storage": "node storage-test.js",
    "test:adversarial": "node adversarial-test.js",
    "test:platform": "node platform-test.js",
    "test:arena": "node arena-test.js",
    "test:engagement": "node engagement-test.js",
    "test:smoke": "node smoke-test.js",
    "recover": "node recovery.js",
    "selftest": "node -e \"const P=require('./platform.js');const r=P.selftestAll();console.log(JSON.stringify(r.counts,null,2));process.exit(r.counts.FAIL?1:0)\"",
    "health": "node -e \"const http=require('http');const port=process.env.PORT||8787;http.get({host:'127.0.0.1',port,path:'/api/health'},r=>{let d='';r.on('data',c=>d+=c);r.on('end',()=>{console.log(d);process.exit(r.statusCode===200?0:1)})}).on('error',e=>{console.error('health check failed: '+e.message);process.exit(1)})\"",
    "test:forgelm": "node forgelm-test.js",
    "test:forgelm-native": "python -m model.forgelm.smoke_test",
    "forgelm:train": "python -m model.forgelm.train",
    "forgelm:chat": "python -m model.forgelm.chat",
    "forgelm:tokenizer": "python -m model.forgelm.tokenizer",
    "forgelm:dataset": "python -m model.forgelm.dataset",
    "forgelm:serve": "python -m model.forgelm.server",
    "test:forgelm-pipeline": "python -m model.forgelm.pipeline_smoke_test",
    "test:forgelm-server": "python -m model.forgelm.server_smoke_test",
    "forgelm:sft": "python -m model.forgelm.sft",
    "forgelm:dpo": "python -m model.forgelm.dpo",
    "forgelm:traces": "python -m model.forgelm.traces",
    "forgelm:eval": "python -m model.forgelm.evals",
    "forgelm:promote": "python -m model.forgelm.promotion",
    "test:forgelm-advanced": "python -m model.forgelm.advanced_smoke_test",
    "forgelm:quality-eval": "python -m model.forgelm.quality_eval",
    "forgelm:benchmark": "python -m model.forgelm.benchmark",
    "forgelm:bundle": "python -m model.forgelm.bundle",
    "forgelm:export": "python -m model.forgelm.inference_export",
    "forgelm:device-profile": "python -m model.forgelm.device_profile",
    "test:forgelm-mobile": "python -m model.forgelm.mobile_smoke_test",
    "forgelm:regression-eval": "python -m model.forgelm.regression_eval",
    "test:forgelm-regression": "python -m model.forgelm.regression_smoke_test"
  },
  "dependencies": {},
  "devDependencies": {},
  "comment": "Node runtime remains zero-dependency by design. ForgeLM native training/chat is an optional Python/PyTorch runtime under model/forgelm."
}\n