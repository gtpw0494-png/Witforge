{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intraultuniversalion.local/schemas/plugin-manifest-v2.json",
  "title": "UAI Plugin Manifest v2",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "entrypoint",
    "capabilities",
    "permissions",
    "risk",
    "timeoutMs",
    "provenance"
  ],
  "properties": {
    "apiVersion": {
      "enum": [
        "1",
        "2"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "requiresCapabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "permissions": {
      "type": "object",
      "required": [
        "filesystem",
        "network",
        "process"
      ],
      "properties": {
        "filesystem": {
          "type": "object",
          "required": [
            "read",
            "write"
          ],
          "properties": {
            "read": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "write": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "network": {
          "type": "object",
          "required": [
            "allow"
          ],
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(\\\\*\\\\.)?[A-Za-z0-9.-]+$"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "process": {
          "type": "object",
          "required": [
            "spawn"
          ],
          "properties": {
            "spawn": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 300000
    },
    "reversible": {
      "type": "boolean"
    },
    "resourceLimits": {
      "type": "object",
      "properties": {
        "cpuMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        },
        "memoryMb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 10000000
        }
      },
      "additionalProperties": false
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "external": {
            "type": "boolean"
          },
          "reversible": {
            "type": "boolean"
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 300000
          },
          "idempotencyRequired": {
            "type": "boolean"
          },
          "idempotencyTtlMs": {
            "type": "integer",
            "minimum": 60000,
            "maximum": 604800000
          },
          "secrets": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "requiresCapabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "inputSchema": {
            "type": "object"
          },
          "outputSchema": {
            "type": [
              "object",
              "null"
            ]
          },
          "resourceLimits": {
            "type": "object",
            "properties": {
              "cpuMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 300000
              },
              "memoryMb": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65536
              },
              "maxOutputBytes": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 10000000
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "sha256"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "signature": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "publicKeyPem": {
          "type": "string"
        },
        "signatureBase64": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": true
}
